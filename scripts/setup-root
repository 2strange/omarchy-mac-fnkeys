#!/usr/bin/bash
# Privileged half of scripts/setup.
#
# This file is never executed by pathname. scripts/setup reads it into memory
# and hands the text to root with `bash -c`, and streams the helper's bytes on
# stdin. Root therefore reads nothing from the user-writable plugin checkout
# after authorization: it installs only the helper bytes it received, and only
# if they hash to the pin below.
#
#   <helper bytes> | sudo /usr/bin/bash -c "$(<scripts/setup-root)" setup-root <user>
#
# Update HELPER_SHA256 whenever scripts/omarchy-mac-fnmode changes:
#   sha256sum scripts/omarchy-mac-fnmode
set -euo pipefail
export PATH=/usr/bin:/usr/sbin
umask 077

readonly HELPER_SHA256=e93592f636c44727b509c3b3a3ab33d3bcd09f0d49764dafdf7e820588301700
readonly helper=/usr/local/libexec/omarchy-mac-fnmode
readonly policy=/etc/sudoers.d/omarchy-mac-fnmode
user_name=${1:-}

fail() {
  printf 'setup-root: %s\n' "$1" >&2
  exit 1
}

[ "$(id -u)" -eq 0 ] || fail "must run as root"
[ "$#" -eq 1 ] || fail "expected exactly one argument: the user name"
[[ $user_name =~ ^[a-z_][a-z0-9_-]*$ ]] || fail "invalid user name"
id "$user_name" >/dev/null 2>&1 || fail "unknown user '$user_name'"
[ -e /sys/module/hid_apple/parameters/fnmode ] || fail "hid_apple fnmode is unavailable"

# Root-owned, mode 700 staging area. Nothing under it is reachable by the user.
work=$(mktemp -d /run/omarchy-mac-fnmode.XXXXXX)
trap 'rm -rf "$work"' EXIT

# Receive the helper by value and refuse anything that does not match the pin.
[ ! -t 0 ] || fail "helper bytes must be piped on stdin; run scripts/setup instead"
head -c 65536 >"$work/helper"
[ -s "$work/helper" ] || fail "no helper bytes received on stdin"
actual=$(sha256sum "$work/helper" | cut -d' ' -f1)
[ "$actual" = "$HELPER_SHA256" ] ||
  fail "helper hash $actual does not match pinned $HELPER_SHA256; refusing to install"
head -c2 "$work/helper" | grep -q '^#!' || fail "helper is not a script"

install -o root -g root -m 755 -D "$work/helper" "$helper"
installed=$(sha256sum "$helper" | cut -d' ' -f1)
[ "$installed" = "$HELPER_SHA256" ] || { rm -f "$helper"; fail "installed helper failed verification"; }

# Only the fixed helper with a literal argument. No wildcards, no shell.
cat >"$work/sudoers" <<EOF
# Managed by the MacBook Function Keys Omarchy plugin.
# Lets $user_name switch hid_apple fnmode through the fixed root helper only.
$user_name ALL=(root) NOPASSWD: $helper 1, $helper 2
EOF
visudo -cf "$work/sudoers" >/dev/null || fail "generated sudoers rule failed validation"
install -o root -g root -m 440 -D "$work/sudoers" "$policy"

# Printed keys first. Hold Fn for real F1-F12.
"$helper" 1 >/dev/null
printf 'Installed %s (sha256 %s) and %s; fnmode=1 is active and persisted.\n' \
  "$helper" "${HELPER_SHA256:0:12}" "$policy"
