#!/usr/bin/env bash
# Privileged half of scripts/setup. Invoked as:
#   sudo bash scripts/setup-root <user> <path-to-omarchy-mac-fnmode>
set -euo pipefail

helper=/usr/local/libexec/omarchy-mac-fnmode
policy=/etc/sudoers.d/omarchy-mac-fnmode
user_name=${1:-}
helper_source=${2:-}

fail() {
  printf 'setup-root: %s\n' "$1" >&2
  exit 1
}

[ "$(id -u)" -eq 0 ] || fail "must run as root"
[[ $user_name =~ ^[a-z_][a-z0-9_-]*$ ]] || fail "invalid user name"
id "$user_name" >/dev/null 2>&1 || fail "unknown user '$user_name'"
[ -f "$helper_source" ] || fail "helper source not found: $helper_source"
[ -e /sys/module/hid_apple/parameters/fnmode ] || fail "hid_apple fnmode is unavailable"

install -Dm755 "$helper_source" "$helper"

# Only the fixed helper with a literal argument. No wildcards, no shell.
tmp=$(mktemp)
cat >"$tmp" <<EOF
# Managed by the MacBook Function Keys Omarchy plugin.
# Lets $user_name switch hid_apple fnmode through the fixed root helper only.
$user_name ALL=(root) NOPASSWD: $helper 1, $helper 2
EOF
visudo -cf "$tmp" >/dev/null || { rm -f "$tmp"; fail "generated sudoers rule failed validation"; }
install -Dm440 "$tmp" "$policy"
rm -f "$tmp"

# Printed keys first. Hold Fn for real F1-F12.
"$helper" 1 >/dev/null
printf 'Installed %s and %s; fnmode=1 is active and persisted.\n' "$helper" "$policy"
